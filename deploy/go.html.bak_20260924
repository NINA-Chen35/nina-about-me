<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>前往 Nina 的影片</title>
<style>
  :root { color-scheme: light only; }
  body { margin:0; padding:40px 16px; font-family:-apple-system,"PingFang TC","Noto Sans TC",sans-serif; background:#fff7f3; color:#333; text-align:center; }
  a { color:#e8735a; font-weight:600; }
</style>
</head>
<body>
<p>正在帶你去 Nina 的影片…</p>
<p id="fallback" hidden>沒有自動跳轉的話，<a id="link" href="https://www.instagram.com/1minaday.nina/">點這裡</a></p>
<script>
(function () {
  // Threads 串文出口的追蹤跳轉：/go.html?r=<IG reel 短碼>&s=<串文代號>
  // 記一次 th-<s> 事件到自己的 Supabase（同首頁 trackGb 的 API），然後跳到 IG 影片。
  var q = new URLSearchParams(location.search);
  var r = (q.get('r') || '').replace(/[^A-Za-z0-9_-]/g, '').slice(0, 40);
  var s = (q.get('s') || '').replace(/[^A-Za-z0-9_-]/g, '').slice(0, 40);
  var target = r ? 'https://www.instagram.com/reel/' + r + '/' : 'https://www.instagram.com/1minaday.nina/';
  document.getElementById('link').href = target;
  document.getElementById('fallback').hidden = false;
  try {
    fetch('https://creator-income-nine.vercel.app/api/public/track', {
      method: 'POST', headers: { 'Content-Type': 'text/plain' },
      body: JSON.stringify({ key: 'th-' + (s || 'unknown'), path: '/go' }), keepalive: true
    }).catch(function(){});
  } catch (e) {}
  setTimeout(function () { location.replace(target); }, 150);
})();
</script>
</body>
</html>
